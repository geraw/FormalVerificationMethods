{
    "name": "formal-verification-methods",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "slidev build",
        "build:all": "node build-all.js",
        "build:force": "cross-env FORCE_REBUILD=1 node build-all.js",
        "dev": "slidev index.md --open",
        "dev:intro": "slidev 00-intro.md --open",
        "dev:00": "slidev 00-intro.md --open",
        "dev:01": "slidev 01-transition-systems.md --open",
        "dev:02": "slidev 02-program-graphs.md --open",
        "dev:03": "slidev 03-parallelism-and-concurrency.md --open",
        "dev:04": "slidev 04-channel-systems.md --open",
        "dev:05": "slidev 05-nanopromela.md --open",
        "dev:06": "slidev 06-SMV.md --open",
        "dev:07": "slidev 07-state-explosion.md --open",
        "dev:z3": "concurrently \"node runner-server.js\" \"slidev z3.md --open\""
    },
    "dependencies": {
        "@slidev/cli": "^52.15.2",
        "@slidev/theme-default": "latest",
        "@slidev/theme-seriph": "latest",
        "@types/katex": "^0.16.8",
        "@types/three": "^0.182.0",
        "body-parser": "^2.2.2",
        "concurrently": "^9.2.1",
        "cors": "^2.8.6",
        "cytoscape": "^3.33.1",
        "d3": "^7.9.0",
        "d3-selection": "^3.0.0",
        "d3-transition": "^3.0.1",
        "express": "^5.2.1",
        "katex": "^0.16.28",
        "monaco-editor": "latest",
        "slidev-addon-python-runner": "^0.1.3",
        "slidev-theme-academic": "latest",
        "slidev-theme-frankfurt": "1.0.4",
        "three": "^0.182.0",
        "venn.js": "^0.2.20"
    },
    "devDependencies": {
        "cross-env": "^7.0.3"
    },
    "overrides": {
        "venn.js": {
            "fmin": "0.0.4"
        }
    },
    "version": "1.0.0",
    "description": "Interactive slide decks for the Formal Verification Methods course content, built with [Slidev](https://sli.dev/).",
    "main": "build-all.js",
    "keywords": [],
    "author": "",
    "license": "ISC"
}
